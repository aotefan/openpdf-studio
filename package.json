{
  "name": "openpdf-studio",
  "version": "0.2.0",
  "private": true,
  "type": "module",
  "main": "desktop/main.cjs",
  "description": "免费开源 PDF 编辑器 | Windows / macOS 本地编辑、离线 OCR、PDF 转 Word",
  "scripts": {
    "dev": "vite --host 127.0.0.1",
    "build": "tsc -b && vite build",
    "start": "electron .",
    "test:ui": "playwright test",
    "package": "node scripts/package.mjs",
    "test:engine": "node scripts/python.cjs -m pytest tests -q",
    "test:desktop": "node --test tests/test_*.cjs",
    "prestart": "node scripts/check-runtime.cjs --electron --installed",
    "check:runtime": "node scripts/check-runtime.cjs",
    "check:site": "node scripts/python.cjs scripts/check-site.py",
    "pretest:ui": "node scripts/check-runtime.cjs --electron --installed",
    "package:win": "node scripts/package.mjs --platform=win32",
    "build:native": "node scripts/python.cjs scripts/build-native.py",
    "test:packaged": "node scripts/test-portable.mjs"
  },
  "dependencies": {
    "i18next": "^25.6.0",
    "lucide-react": "^0.468.0",
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "react-i18next": "^17.1.0"
  },
  "devDependencies": {
    "@electron/packager": "^20.3.0",
    "@playwright/test": "^1.56.1",
    "@types/react": "^19.2.0",
    "@types/react-dom": "^19.2.0",
    "@vitejs/plugin-react": "^5.0.4",
    "electron": "45.2.3",
    "typescript": "^5.9.3",
    "vite": "^7.1.12"
  },
  "license": "AGPL-3.0-or-later",
  "author": "OpenPDF Studio contributors",
  "repository": {
    "type": "git",
    "url": "https://github.com/aotefan/openpdf-studio.git"
  },
  "homepage": "https://aotefan.github.io/openpdf-studio/",
  "bugs": {
    "url": "https://github.com/aotefan/openpdf-studio/issues"
  },
  "keywords": [
    "pdf-editor",
    "free-pdf-editor",
    "wps-pdf",
    "reverse-engineering",
    "rea",
    "ocr",
    "pdf-to-word",
    "macos",
    "chinese",
    "windows"
  ],
  "engines": {
    "node": ">=24.22.2 <25 || >=26.13.0 <27"
  },
  "overrides": {
    "glob": "^14.0.4",
    "minimatch": "^11.0.5"
  }
}
